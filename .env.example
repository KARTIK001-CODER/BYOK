# Application Environment
APP_NAME=RAGForge
APP_ENV=development
DEBUG=true
VERSION=0.6.0

# Server Configuration
HOST=0.0.0.0
PORT=8000
API_V1_STR=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173","http://127.0.0.1:5173"]

# Database Configuration (PostgreSQL 16 + pgvector / Neon PostgreSQL)
# Format: postgresql+asyncpg://<username>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ragforge
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_ECHO=false

# Security & JWT Configuration
JWT_SECRET_KEY=change-this-to-a-super-secret-hex-key-minimum-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Object Storage & Upload Configuration
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=data/storage
MAX_UPLOAD_SIZE_MB=25

# Document Ingestion & Chunking Configuration
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
MAX_EXTRACTED_TEXT_CHARS=5000000
MAX_CHUNKS_PER_DOCUMENT=10000

# Embedding Generation & Vector Storage Configuration
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384
EMBEDDING_BATCH_SIZE=32
EMBEDDING_DEVICE=cpu
MAX_EMBEDDING_CHUNKS_PER_JOB=10000

# Retrieval & Search Configuration (Phase 6)
DEFAULT_SEARCH_MODE=hybrid
DEFAULT_TOP_K=10
DEFAULT_CANDIDATE_K=50
RRF_K=60
MAX_QUERY_LENGTH=2000

# Generation Engine & LLM Provider Configuration (Phase 7)
DEFAULT_LLM_PROVIDER=groq
DEFAULT_LLM_MODEL=qwen/qwen3.8-27b
GROQ_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
LLM_TIMEOUT_SECONDS=60
MAX_CONTEXT_TOKENS=12000
MAX_HISTORY_MESSAGES=10
DEFAULT_TEMPERATURE=0.2
MAX_GENERATION_TOKENS=4096

# Research fallback / Intelligence / Reranking / Verification (all opt-in)
ENABLE_ARXIV_FALLBACK=false
ARXIV_TIMEOUT_SECONDS=2
ENABLE_QUERY_INTELLIGENCE=false
ENABLE_RERANKING=false
RERANKER_CANDIDATE_K=30
ENABLE_GROUNDEDNESS_CHECK=false
ENABLE_ADAPTIVE_RETRIEVAL=false
ENABLE_QUERY_EXPANSION=false
ENABLE_MULTI_QUERY=false
ENABLE_QUERY_DECOMPOSITION=false
ENABLE_RETRIEVAL_FAILURE_DETECTION=false

# BYOK vault master key (must override in production; vault impl pending Phase 8)
API_KEY_ENCRYPTION_KEY=change-this-to-a-32-byte-hex-key-for-byok-encryption-vault

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=text

