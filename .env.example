# Application Environment
APP_NAME=RAGForge
APP_ENV=development
DEBUG=true
VERSION=0.4.0

# Server Configuration
HOST=0.0.0.0
PORT=8000
API_V1_STR=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173","http://127.0.0.1:5173"]

# Database Configuration (PostgreSQL 16 + pgvector / Neon PostgreSQL)
# Format: postgresql+asyncpg://<username>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ragforge
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_ECHO=false

# Security & JWT Configuration
JWT_SECRET_KEY=change-this-to-a-super-secret-hex-key-minimum-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Object Storage & Upload Configuration
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=data/storage
MAX_UPLOAD_SIZE_MB=25

# Document Ingestion & Chunking Configuration
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
MAX_EXTRACTED_TEXT_CHARS=5000000
MAX_CHUNKS_PER_DOCUMENT=10000

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=text
