# ==============================================================================
# RAGForge Server Configuration (.env.example)
#
# IMPORTANT: This file contains ONLY server-level configuration.
# User-provided LLM/Embedding provider API keys (Groq, OpenAI, Gemini, Cohere)
# will NEVER be stored in environment variables. In later phases, provider keys
# will be encrypted and stored securely in the database via BYOK architecture.
# ==============================================================================

# Application Environment (development, staging, production)
APP_ENV=development
APP_NAME=RAGForge
DEBUG=true

# Server Network Settings
HOST=0.0.0.0
PORT=8000
API_V1_STR=/api/v1

# Logging Configuration (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO
LOG_FORMAT=text

# Database Configuration (PostgreSQL with pgvector)
# Local Docker or local instance:
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ragforge
# Container-to-container connection (used inside Docker network):
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/ragforge

# Database Connection Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# CORS Origins (Comma-separated list of allowed origins)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
